<?xml version="1.0" encoding="utf-8"?>
<!--
  Manage Mods. The toolbar is standalone - `setSupportActionBar` is never called on it (docs/
  UI-SPEC.md), exactly as the Save Management screen does it, so the library never fights a host
  app's own ActionBar theme.

  The mod rows are built in code (one per ModManagementConfig.mods entry), because the row count is
  per-host. This is the only place in the library where a MaterialSwitch appears in a list, and it
  is deliberately confined to this sub-screen: UI-SPEC forbids a switch *option kind* in the main
  Settings column, not switches inside a screen of their own.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/pl_mods_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/pl_manage_mods" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pl_mods_hint"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/pl_mods_master"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pl_mods_master" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:background="?android:attr/listDivider" />

            <LinearLayout
                android:id="@+id/pl_mods_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/pl_mods_libraries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />


        </LinearLayout>
    </ScrollView>
</LinearLayout>
