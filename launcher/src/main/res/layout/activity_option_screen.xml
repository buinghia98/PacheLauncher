<?xml version="1.0" encoding="utf-8"?>
<!--
  A LauncherOptionScreen. The toolbar is standalone - `setSupportActionBar` is never called on it
  (docs/UI-SPEC.md), exactly as Manage Mods and Save Management do it - and its navigation arrow is
  the only way back; this screen has no bottom Back button.

  The rows are built in code (OptionRows), because both their count and their contents are per-host,
  and they are the SAME rows the Settings card draws - only their address differs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/pl_option_screen_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <com.teampacheworks.launcher.ui.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="560dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/pl_option_screen_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/pl_option_screen_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.teampacheworks.launcher.ui.MaxWidthLinearLayout>
    </ScrollView>
</LinearLayout>
