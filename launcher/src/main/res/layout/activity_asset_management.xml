<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <com.teampacheworks.launcher.ui.MaxWidthLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="680dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pl_manage_assets"
            android:textColor="?attr/colorPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pl_assets_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="@string/pl_assets_scanning"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/pl_asset_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Shown when the data is present but locked to another uid. Not a card and not a toast:
             it is the one message on this screen that tells the user their files are fine and the
             permissions are not, which is otherwise indistinguishable from "nothing installed". -->
        <TextView
            android:id="@+id/pl_assets_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:textColor="?attr/colorError"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- The route that needs no terminal, so it is the filled button and it comes first. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pl_import_deploy_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pl_deploy_title"
            android:visibility="gone" />

        <!-- The route for a player who has the PC game files but no PC-built install folder. Below
             the import, because importing a folder someone already built is the shorter road when
             it exists at all. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pl_build_data_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pl_build_title"
            android:visibility="gone" />

    </com.teampacheworks.launcher.ui.MaxWidthLinearLayout>
</ScrollView>
