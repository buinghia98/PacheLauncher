<?xml version="1.0" encoding="utf-8"?>
<!--
  Main launcher screen (docs/UI-SPEC.md "Main screen"): centred column capped at 560dp (full width
  on narrower screens - see MaxWidthLinearLayout), PLAY the one filled control, everything else
  outlined, two MaterialCardView groups with a bold colorPrimary header and an 11sp hint line under
  every row. Icon/title/subtitle/footer text are set programmatically from LauncherConfig in
  LauncherActivity - only the theme's seed colour and this text are per-game; everything else here
  is identical for every port using this library.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.teampacheworks.launcher.ui.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="560dp"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- header: icon + title/subtitle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/pl_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/pl_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pl_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- PLAY: the one filled control on the screen -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pl_play_button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/pl_play"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="32dp" />

            <!-- Structural parity with the Dustaet design standard: a host with no first-run
                 asset-install step leaves these three GONE, but the structure exists so every
                 port using this library stays in lock-step. -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pl_install_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pl_status_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pl_error_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pl_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textColor="@color/pl_error"
                    android:textSize="13sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/pl_settings_header"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Aspect ratio: plain framework Spinner, NOT an exposed dropdown
                         (docs/UI-SPEC.md). -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="@string/pl_aspect_label"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/pl_aspect_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/pl_aspect_hint"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />

                    <!-- Control order: aspect -> Debug logging -> Show FPS. -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/pl_debug_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/pl_debug_logging" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/pl_debug_logging_hint"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/pl_fps_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/pl_show_fps" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/pl_show_fps_hint"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pl_export_logs_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pl_export_logs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save & Cloud card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/pl_save_and_cloud_header"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pl_save_management_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/pl_manage_saves" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pl_cloud_backup_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/pl_cloud_sync_gist" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pl_save_and_cloud_notice"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- footer -->
            <TextView
                android:id="@+id/pl_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />
        </com.teampacheworks.launcher.ui.MaxWidthLinearLayout>
    </FrameLayout>
</ScrollView>
