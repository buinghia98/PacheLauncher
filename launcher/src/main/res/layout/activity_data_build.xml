<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <com.teampacheworks.launcher.ui.MaxWidthLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="680dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/pl_build_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pl_build_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pl_build_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <!-- Everything the inspection produced: the headline, the facts behind it, and the two
             choices. One card, because they are one answer to one question ("what is in the folder
             you picked, and what can I do with it"). Gone until a folder has been read. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pl_build_plan_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/pl_build_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pl_build_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/pl_build_variant_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/pl_build_what"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/pl_build_variants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Host-declared option groups, built in code: how many there are and what they
                     contain is config, not layout. -->
                <LinearLayout
                    android:id="@+id/pl_build_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/pl_build_source_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/pl_build_source_mode"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/pl_build_source_modes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- DataBuildConfig.consumeSourceSwitch: one switch instead of the group above. -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/pl_build_consume_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pl_build_consume_switch"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Two scales. The phase moves a handful of times across a forty-minute build; the counts
             move constantly inside it. One bar over the whole thing would be indistinguishable from
             a hang for minutes at a time. -->
        <TextView
            android:id="@+id/pl_build_phase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pl_build_counts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pl_build_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pl_build_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="start"
            android:singleLine="true"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pl_build_start"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/pl_build_start"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pl_build_choose"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pl_build_choose" />

        <!-- DataBuildConfig.archiveMimeTypes: pick one archive file instead of a folder. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pl_build_choose_archive"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pl_build_choose_archive"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pl_build_cancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/pl_build_cancel"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pl_build_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />
    </com.teampacheworks.launcher.ui.MaxWidthLinearLayout>
</ScrollView>
