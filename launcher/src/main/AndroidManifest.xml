<?xml version="1.0" encoding="utf-8"?>
<!--
  Library manifest. Activities are declared here so a host app gets them for free via manifest
  merging, but every one of them is exported="false" - the host app's own launcher-facing activity
  (or LauncherActivity itself, referenced from the host's intent-filter) is what actually gets
  android:exported="true"/android:label/android:theme from the HOST manifest via a merge override.
  See docs/INTEGRATION.md for the exact host-side manifest snippet.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used by GistClient (OkHttp) for cloud sync. A connected gamepad needs no runtime
         permission beyond what the OS already grants an input device, so no BLUETOOTH permission
         is declared here; a host whose game engine talks to a controller over Bluetooth directly
         (rather than through the standard InputDevice APIs this library's input layer uses)
         declares that permission itself. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- DeployImportActivity moves an entire install (~14 GB on this project's reference game) one
         file at a time. Without this the move stops whenever the device dozes, and the user is
         asked to stare at a progress bar for an hour. The lock is PARTIAL and is released on every
         exit path including cancellation; no wake lock is held outside that screen. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <activity
            android:name="com.teampacheworks.launcher.LauncherActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.PacheLauncher" />

        <activity
            android:name="com.teampacheworks.launcher.SaveManagementActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName="com.teampacheworks.launcher.LauncherActivity"
            android:theme="@style/Theme.PacheLauncher" />

        <activity
            android:name="com.teampacheworks.launcher.CloudBackupActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName="com.teampacheworks.launcher.LauncherActivity"
            android:theme="@style/Theme.PacheLauncher" />

        <activity
            android:name="com.teampacheworks.launcher.AssetManagementActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName="com.teampacheworks.launcher.LauncherActivity"
            android:theme="@style/Theme.PacheLauncher" />

        <!-- keepScreenOn is deliberately NOT set here: the wake lock keeps the move running, so the
             user should be free to put the tablet down. -->
        <activity
            android:name="com.teampacheworks.launcher.DeployImportActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName="com.teampacheworks.launcher.AssetManagementActivity"
            android:theme="@style/Theme.PacheLauncher" />

        <activity
            android:name="com.teampacheworks.launcher.GpuDriverManagementActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName="com.teampacheworks.launcher.LauncherActivity"
            android:theme="@style/Theme.PacheLauncher" />

        <activity
            android:name="com.teampacheworks.launcher.ModManagementActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName="com.teampacheworks.launcher.LauncherActivity"
            android:theme="@style/Theme.PacheLauncher" />

        <!-- One activity for every LauncherOptionScreen a host declares; which one it draws comes
             from the Intent (OptionScreenActivity.EXTRA_SCREEN_KEY), because the screens are config
             data and a manifest entry per host group is not something a library can have. -->
        <activity
            android:name="com.teampacheworks.launcher.OptionScreenActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:parentActivityName="com.teampacheworks.launcher.LauncherActivity"
            android:theme="@style/Theme.PacheLauncher" />
    </application>
</manifest>
