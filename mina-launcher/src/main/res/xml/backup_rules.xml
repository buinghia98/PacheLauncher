<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-API-31 Auto Backup rules (docs/INTEGRATION.md step 4). Keeps the cloud token and cloud
  bookkeeping SharedPreferences file off any device-to-device Auto Backup transfer - see
  TokenStore.kt's KDoc for why this matters.
-->
<full-backup-content>
    <exclude domain="file" path="cloud.token" />
    <exclude domain="sharedpref" path="minathehollower-cloud.xml" />
</full-backup-content>
