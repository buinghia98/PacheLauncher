<?xml version="1.0" encoding="utf-8"?>
<!--
  API-31+ Auto Backup / device-transfer rules (docs/INTEGRATION.md step 4). Mirrors
  backup_rules.xml for cloud/device transfer, which uses this file instead of full-backup-content
  on API 31+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cloud.token" />
        <exclude domain="sharedpref" path="minathehollower-cloud.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cloud.token" />
        <exclude domain="sharedpref" path="minathehollower-cloud.xml" />
    </device-transfer>
</data-extraction-rules>
