<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon built from "Mina - The Hollower.png" key art (docs/UI-SPEC.md "App icon"): a
  centered crop of the cover art as the foreground layer, over a flat dark-maroon background
  sampled from the same artwork. minSdk is 30 (API 26+), so no legacy raster mipmap-*dpi fallback
  is needed.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
